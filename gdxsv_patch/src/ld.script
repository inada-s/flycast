SECTIONS
{
    /* Keep networking first; append widescreen, then statistics. */
    . = 0x0C4E0200;
    gdx.data ALIGN(16) : {
        *(gdx.data)
        *(gdx.data.ws)
        *(gdx.data.stats)
    }
    . = 0x0C4F0000;
    gdx.func ALIGN(16) : {
        *(gdx.func)
        *(gdx.func.ws)
        *(gdx.func.stats)
        *(.rodata*)
    }
    /* gdxsv-1.8.11 savestates retain these hook and renderer-table addresses. */
    ASSERT(gdx_widescreen_transition_matte == 0x0C4F0590, "gdxsv-1.8.11 transition entry changed")
    ASSERT(gdx_widescreen_hud_render == 0x0C4F0640, "gdxsv-1.8.11 HUD callback address changed")
    ASSERT(gdx_widescreen_hud_renderer_table == 0x0C4F06B0, "gdxsv-1.8.11 HUD table address changed")
    ASSERT(gdx_widescreen_result_black_postproject == 0x0C4F06F4, "gdxsv-1.8.11 result entry changed")
    . = 0x0C500000;
    gdx.cheat ALIGN(16) : {
        *(gdx.cheat*)
    }
}
