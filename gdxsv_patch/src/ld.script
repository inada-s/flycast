SECTIONS
{
    /* Fixed areas hold what abi.py pins; gen_abi.py checks every address. */
    . = 0x0C4E0200;
    gdx.data ALIGN(16) : {
        *(gdx.data)             /* networking; gdx_rpc and patch_id pinned */
        . = 0x100;
        *(gdx.data.entry)       /* pinned HUD tables */
        *(gdx.data.ws)
        *(gdx.data.stats)
    }
    . = 0x0C4F0000;
    gdx.func ALIGN(16) : {
        *(gdx.func)             /* networking, pinned */
        . = 0x590;
        *(gdx.func.entry)       /* fixed jump slots, 0x0C4F0590..0x0C4F0800 */
        . = 0x800;
        *(gdx.func.ws)
        *(gdx.func.stats)
        *(.rodata*)
    }
    . = 0x0C500000;
    gdx.cheat ALIGN(16) : {
        *(gdx.cheat*)
    }
}
